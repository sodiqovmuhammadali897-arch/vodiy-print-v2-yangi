rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(email())).data;
    }

    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(email()));
    }

    function isAdmin() {
      return isStaff() && staffDoc().role == 'admin';
    }

    function can(module, action) {
      return isAdmin() ||
        (isStaff() && staffDoc().permissions[module][action] == true);
    }

    // First-ever login from the bootstrap admin email may create their own
    // staff record (once) so there's a way into the app before any staff
    // documents exist. Every other write to this collection requires an
    // existing admin.
    match /staff/{staffEmail} {
      allow read: if isStaff();
      allow create: if isAdmin() ||
        (isSignedIn() && email() == staffEmail &&
         staffEmail == 'sodiqovmuhammadali897@gmail.com' &&
         !exists(/databases/$(database)/documents/staff/$(staffEmail)));
      allow update, delete: if isAdmin();
    }

    // Pechatnik (production staff) only has the "production" permission, not
    // "orders" — but they still need to read the order and flip its status
    // for their own assigned work. The update branch limits them to touching
    // only status/completed_at, never the rest of the order.
    match /orders/{id} {
      allow read: if can('orders', 'view') || can('production', 'view');
      allow create: if can('orders', 'edit');
      allow update: if can('orders', 'edit') ||
        (can('production', 'edit') &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'completed_at']));
      allow delete: if can('orders', 'delete');
    }
    match /order_products/{id} {
      allow read: if can('orders', 'view') || can('production', 'view');
      allow create, update, delete: if can('orders', 'edit');
    }
    match /order_payments/{id} {
      allow read: if can('orders', 'view');
      allow create, update, delete: if can('orders', 'edit');
    }
    match /order_files/{id} {
      allow read: if can('orders', 'view') || can('production', 'view');
      allow create, update, delete: if can('orders', 'edit');
    }

    // Every status transition (who, when, to what) is logged here so it can
    // never be silently lost — entries are append-only, never edited.
    match /order_status_history/{id} {
      allow read: if can('orders', 'view') || can('production', 'view');
      allow create: if can('orders', 'edit') || can('production', 'edit');
      allow update, delete: if isAdmin();
    }

    match /customers/{id} {
      allow read: if can('customers', 'view') || can('production', 'view');
      allow create, update: if can('customers', 'edit');
      allow delete: if can('customers', 'delete');
    }

    // Brands are managed from within a customer's profile, so they share
    // the customers permission rather than having their own module.
    match /brands/{id} {
      allow read: if can('customers', 'view') || can('production', 'view');
      allow create, update: if can('customers', 'edit');
      allow delete: if can('customers', 'delete');
    }

    match /products/{id} {
      allow read: if can('products', 'view');
      allow create, update: if can('products', 'edit');
      allow delete: if can('products', 'delete');
    }

    // Cost price lives in its own collection, readable only by admins, so
    // it never reaches a non-admin client even though the product itself
    // (name, category, price tiers) is visible to anyone with products.view.
    match /product_costs/{id} {
      allow read, write: if isAdmin();
    }

    match /proposals/{id} {
      allow read: if can('proposals', 'view');
      allow create, update: if can('proposals', 'edit');
      allow delete: if can('proposals', 'delete');
    }

    match /expenses/{id} {
      allow read: if can('finance', 'view');
      allow create, update: if can('finance', 'edit');
      allow delete: if can('finance', 'delete');
    }

    // Shared configuration used across modules (dropdowns, dashboards).
    // Any signed-in staff member may read; only admins may change them.
    match /managers/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /holidays/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /company_settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /monthly_plans/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /textile_companies/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Anything not covered above (future modules, e.g. warehouse/finance
    // once they get real data): admins get full access, everyone else is
    // blocked until an explicit rule is added.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
