rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Staff doc IDs are always the lowercased email (see AuthContext.tsx
    // and StaffFormModal.tsx), but Firebase Auth does not normalize the
    // case of request.auth.token.email — an account created/signed-in
    // with any uppercase letters would otherwise fail every isStaff()/
    // isAdmin()/can() check here even though the client-side app (which
    // does lowercase before lookup) shows them as a fully permissioned
    // staff member. Lowercasing here keeps both sides consistent.
    function email() {
      return request.auth.token.email.lower();
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(email())).data;
    }

    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(email()));
    }

    function isAdmin() {
      return isStaff() && staffDoc().role == 'admin';
    }

    function can(module, action) {
      return isAdmin() ||
        (isStaff() && staffDoc().permissions[module][action] == true);
    }

    // First-ever login from the bootstrap admin email may create their own
    // staff record (once) so there's a way into the app before any staff
    // documents exist. Every other write to this collection requires an
    // existing admin.
    match /staff/{staffEmail} {
      allow read: if isStaff();
      allow create: if isAdmin() ||
        (isSignedIn() && email() == staffEmail &&
         staffEmail == 'sodiqovmuhammadali897@gmail.com' &&
         !exists(/databases/$(database)/documents/staff/$(staffEmail)));
      allow update, delete: if isAdmin();
    }

    // Ishlab chiqarish (dispatch) staff only has the "production" permission,
    // not "orders" — but they still need to read the order and flip its
    // status for their own assigned work. The update branch limits them to
    // touching only status/completed_at, never the rest of the order.
    match /orders/{id} {
      allow read: if can('orders', 'view') || can('production', 'view') || can('pechatnik', 'view');
      allow create: if can('orders', 'edit');
      allow update: if can('orders', 'edit') ||
        (can('production', 'edit') &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'completed_at']));
      allow delete: if can('orders', 'delete');
    }
    // Production tracking moved from the order level to the product-line
    // level: each item has its own production_status/assigned printer, so a
    // mixed order (e.g. one Tipografiya line + one Textil line) can move
    // through the shop floor independently per line.
    match /order_products/{id} {
      allow read: if can('orders', 'view') || can('production', 'view') || can('pechatnik', 'view');
      allow create, update, delete: if can('orders', 'edit');
      // Ishlab chiqarish (mas'ul hodim): may assign a printer and/or move
      // the line's own status (non-Textil categories have no dedicated
      // worker panel yet, so this is their only way to progress past
      // "Yangi") — never pricing/quantity/breakdown.
      allow update: if can('production', 'edit') &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['assigned_printer_email', 'assigned_printer_name', 'production_status']);
      // Pechatnik: may only move their own assigned item through the
      // production_status stages, never reassign themselves or edit the
      // product itself.
      allow update: if can('pechatnik', 'edit') &&
        resource.data.assigned_printer_email == email() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['production_status', 'production_accepted_at', 'production_completed_at']);
    }
    match /order_payments/{id} {
      allow read: if can('orders', 'view');
      allow create, update, delete: if can('orders', 'edit');
    }
    match /order_files/{id} {
      allow read: if can('orders', 'view') || can('production', 'view') || can('pechatnik', 'view');
      allow create, update, delete: if can('orders', 'edit');
    }

    // Every status transition (who, when, to what) is logged here so it can
    // never be silently lost — entries are append-only, never edited.
    match /order_status_history/{id} {
      allow read: if can('orders', 'view') || can('production', 'view');
      allow create: if can('orders', 'edit') || can('production', 'edit');
      allow update: if isAdmin();
      // Deleting an order cascades to its history entries — allowed for
      // whoever can delete the order itself, not just admins.
      allow delete: if isAdmin() || can('orders', 'delete');
    }

    match /customers/{id} {
      allow read: if can('customers', 'view') || can('production', 'view') || can('pechatnik', 'view');
      allow create, update: if can('customers', 'edit');
      allow delete: if can('customers', 'delete');
    }

    // Brands are managed from within a customer's profile, so they share
    // the customers permission rather than having their own module.
    match /brands/{id} {
      allow read: if can('customers', 'view') || can('production', 'view') || can('pechatnik', 'view');
      allow create, update: if can('customers', 'edit');
      allow delete: if can('customers', 'delete');
    }

    // The Textil module is a read-only view over Textil-category catalog
    // products, so staff who only have that permission (not Mahsulotlar)
    // can still see it.
    match /products/{id} {
      allow read: if can('products', 'view') || can('textile', 'view');
      allow create, update: if can('products', 'edit');
      allow delete: if can('products', 'delete');
    }

    // Cost price lives in its own collection, readable only by admins, so
    // it never reaches a non-admin client even though the product itself
    // (name, category, price tiers) is visible to anyone with products.view.
    match /product_costs/{id} {
      allow read, write: if isAdmin();
    }

    match /proposals/{id} {
      allow read: if can('proposals', 'view');
      allow create, update: if can('proposals', 'edit');
      allow delete: if can('proposals', 'delete');
    }

    match /expenses/{id} {
      allow read: if can('finance', 'view');
      allow create, update: if can('finance', 'edit');
      allow delete: if can('finance', 'delete');
    }

    // Shared configuration used across modules (dropdowns, dashboards).
    // Any signed-in staff member may read; only admins may change them.
    match /managers/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /holidays/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /company_settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /monthly_plans/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /textile_companies/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Reusable size/color quantity distributions (e.g. repeat school-uniform
    // orders) — shared with whoever can edit orders, not admin-only, since
    // sales/production staff are the ones filling these matrices in.
    match /textile_size_templates/{id} {
      allow read: if can('orders', 'edit') || can('production', 'view');
      allow create, update, delete: if can('orders', 'edit');
    }

    // ── Davomat va KPI ──────────────────────────────────────────────
    // Employee identity for attendance/KPI reuses the existing `staff`
    // collection (email-keyed) rather than a separate `employees`
    // collection, so there is only ever one authoritative record per
    // person.

    // The public key material here is only ever written by Cloud Functions
    // (Admin SDK, bypasses rules) after real WebAuthn verification — a
    // client can never forge or tamper with a credential. Deleting a
    // device (lost phone, etc.) is a harmless, non-cryptographic action so
    // the owner or an admin may do that directly.
    match /webauthn_credentials/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.employeeEmail == email());
      allow delete: if isAdmin() || (isStaff() && resource.data.employeeEmail == email());
      allow create, update: if false;
    }

    // One-time WebAuthn challenges are pure server state — no client, not
    // even the owning staff member, ever reads or writes these directly.
    match /webauthn_challenges/{id} {
      allow read, write: if false;
    }

    // Check-in/check-out itself only ever happens through the Cloud
    // Functions (biometric + GPS verified there). Direct client writes are
    // reserved for admin corrections, which must go through can('attendance','edit')
    // and are expected to also be logged to attendance_audit by the caller.
    match /attendance/{id} {
      allow read: if isAdmin() || can('attendance', 'view') ||
        (isStaff() && resource.data.employeeId == email());
      allow create, update: if can('attendance', 'edit');
      allow delete: if isAdmin();
    }

    match /attendance_audit/{id} {
      allow read: if isAdmin();
      allow create: if can('attendance', 'edit');
      allow update, delete: if isAdmin();
    }

    match /work_schedules/{id} {
      allow read: if isStaff();
      allow write: if can('attendance', 'edit');
    }

    match /leave_requests/{id} {
      allow read: if isAdmin() || can('attendance', 'view') ||
        (isStaff() && resource.data.employeeId == email());
      allow create: if isStaff() &&
        (request.resource.data.employeeId == email() || can('attendance', 'edit'));
      allow update, delete: if can('attendance', 'edit');
    }

    match /kpi_settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /employee_kpi/{id} {
      allow read: if isAdmin() || can('attendance', 'view') ||
        (isStaff() && resource.data.employeeId == email());
      allow write: if can('attendance', 'edit');
    }

    // Admin/managers assign tasks; the assignee may only ever touch their
    // own (to mark it done), never someone else's or the task details.
    match /tasks/{id} {
      allow read: if isAdmin() || can('tasks', 'view') ||
        (isStaff() && resource.data.assigned_to_email == email());
      allow create: if can('tasks', 'edit');
      allow update: if isAdmin() ||
        (can('tasks', 'edit') && resource.data.assigned_to_email == email());
      allow delete: if isAdmin();
    }

    // Anything not covered above (future modules, e.g. warehouse/finance
    // once they get real data): admins get full access, everyone else is
    // blocked until an explicit rule is added.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
